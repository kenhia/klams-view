# Copy to `.env` (gitignored) — `just run` and `just dev-api` source it.
# Every value here has a working default except KLAMS_TOKEN.

# Base URL of the klams service you want to view.
KLAMS_URL=http://localhost:7777

# Bearer token klams-view presents to klams. Read scope is enough:
# klams-view never writes, and /healthz and /metrics need no token.
# Mint one in klams' config as its own `[[auth.tokens]]` grant rather
# than reusing an agent's token, so the dashboard shows up as itself
# in klams' own author/metrics views. Without it the server still
# starts and the shell renders, but /api routes return 503.
KLAMS_TOKEN=

# Address the viewer listens on. Default 127.0.0.1:7779 — localhost
# only. Bind 0.0.0.0 to reach it from other machines, and only do that
# on a network you trust: klams-view has no authentication of its own,
# so anyone who can reach this port reads the whole memory store.
KLAMS_VIEW_ADDR=127.0.0.1:7779

# Built SPA directory to serve. Defaults to `web/build` when present.
# Set it empty to run API-only, which is what `just dev-web` expects
# (vite serves the frontend on :5174 and proxies /api here).
KLAMS_VIEW_STATIC=web/build

# --- the homelab package store (sprint 003, #1013) -------------------
# Releases go through the store: `just publish` puts a versioned binary
# and SPA bundle there, `just deploy` installs from it. Same variable
# names klams uses — one store, so one pair per machine, not per repo.
# Neither has a default: a guessed hostname fails as a confusing curl or
# ssh error instead of naming the variable you forgot.

# Base URL the store is READ from. Needed by every deploy, on any host.
KLAMS_STORE_URL=

# ssh host that RUNS `kpkg`. Needed by `just publish` only.
KLAMS_STORE_HOST=

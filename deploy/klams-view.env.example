# Installed to /etc/klams-view/klams-view.env (0640 root:klams-view) on
# first deploy and never overwritten afterwards — edit it in place and
# `sudo systemctl restart klams-view` to pick changes up.

# klams, from the viewer's host. Same machine → localhost.
KLAMS_URL=http://localhost:7777

# A read-scoped klams token minted for klams-view specifically.
KLAMS_TOKEN=

# klams-view has NO authentication of its own: whoever reaches this
# port reads the whole memory store. 0.0.0.0 relies on the host
# firewall to scope that — see docs/deploy.md before changing it.
KLAMS_VIEW_ADDR=0.0.0.0:7778

# The SPA bundle, as installed by deploy/install-systemd.sh.
KLAMS_VIEW_STATIC=/usr/local/share/klams-view/web
